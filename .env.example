# Copy to .env and change the passwords. .env is gitignored.

POSTGRES_USER=lowcy
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lowcy

# Host ports; change if another project already uses them.
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000

# Photo storage: plain files. docker compose mounts ./.storage into api, api-worker and worker;
# set this only when running the API outside docker (default: <repo>/.storage).
# STORAGE_LOCAL_ROOT=
# Max player photo size in MB (the upload endpoint answers 413 above it).
MAX_UPLOAD_MB=15
# Base of the upload URL the phone gets, e.g. a tunnel URL. Empty = the address the phone used
# to call the API (works for http://<laptop IP>:8000).
PUBLIC_BASE_URL=

# API
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
# Accept a manually set position from the client (long tap on the map). Keep on for the demo.
DEMO_MODE=true
# Every submitted photo is accepted without the ML worker. Set to false once the `worker`
# service runs AND reference photos are loaded (worker/: seed_dev + add_refs); without refs
# every photo would be rejected as not_matched.
VERIFY_STUB=true
SHARE_BASE_URL=https://lowcyhistorii.pl
