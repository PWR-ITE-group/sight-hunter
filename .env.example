# Copy to .env and change the passwords. .env is gitignored.

POSTGRES_USER=lowcy
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lowcy

# Host ports; change if another project already uses them.
POSTGRES_PORT=5432
REDIS_PORT=6379
S3_PORT=8333
API_PORT=8000

# S3-compatible storage (SeaweedFS locally, Cloudflare R2 in prod).
S3_ACCESS_KEY=lowcy
S3_SECRET_KEY=change-me
S3_BUCKET=lowcy
S3_ENDPOINT=http://localhost:8333
# Address the phone can reach, e.g. http://192.168.1.20:8333 or a tunnel URL. Empty = S3_ENDPOINT.
S3_PUBLIC_ENDPOINT=

# API
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
# Accept a manually set position from the client (long tap on the map). Keep on for the demo.
DEMO_MODE=true
# No ML worker yet: every submitted photo is accepted. Turn off once worker/ is running.
VERIFY_STUB=true
SHARE_BASE_URL=https://lowcyhistorii.pl
